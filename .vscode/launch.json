{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--enable-proposed-api=uniquetrij.freellmapi-chat-provider",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/build/out/**/*.js"
      ],
      "preLaunchTask": "TypeScript Compile"
    }
  ]
}
